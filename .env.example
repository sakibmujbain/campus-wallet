# ─────────────────────────────────────────────────────────────────────────────
# Campus Wallet — environment
# Copy to `.env` and fill in from your Supabase project (Settings → Database).
# NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# App runtime connection — Supabase TRANSACTION-mode pooler (Supavisor), port 6543.
# Serverless functions MUST use this pooled URL, not the direct one, or they
# exhaust the ~60-connection cap. Add `?sslmode=require`.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# Migrations / DDL / seeds connection — port 5432. Never used by the app at request time.
# IMPORTANT: use Supabase's "Session pooler" string here (pooler host, port 5432),
# NOT the "Direct connection" (db.<ref>.supabase.co) — that one is IPv6-only on the
# free tier and will fail from most laptops/CI. The session pooler is IPv4-friendly.
DATABASE_URL_DIRECT="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# App-side pool size (keep small on serverless).
PG_POOL_MAX=3

# TLS hardening (optional). Default: encrypt but don't verify the cert chain
# (Supabase pooler compatibility). For full MITM protection set PG_SSL_STRICT=true
# and, if the pooler CA isn't in the system trust store, paste it into PG_CA_CERT.
# PG_SSL_STRICT=true
# PG_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ── Supabase Auth (client + server) ──────────────────────────────────────────
# From the Supabase dashboard: Settings -> API (or the "Connect" modal).
# The publishable/anon key is safe to expose to the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<publishable or anon key>"

# pgTyped introspection connection (usually the same host as DIRECT).
PGHOST="aws-0-<region>.pooler.supabase.com"
PGPORT=5432
PGUSER="postgres.<project-ref>"
PGPASSWORD="<password>"
PGDATABASE="postgres"
