{
  "name": "campus-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Campus Wallet — a student fintech platform on PostgreSQL (DBMS course project).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "migrate": "node scripts/migrate.mjs up",
    "migrate:down": "node scripts/migrate.mjs down",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql",
    "db:seed": "node scripts/run-sql.mjs db/seed.sql",
    "db:sql": "node scripts/run-sql.mjs",
    "db:smoke": "node scripts/smoke.mjs",
    "pgtyped": "node scripts/pgtyped.mjs",
    "pgtyped:watch": "node scripts/pgtyped.mjs -w"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "next": "^15.1.3",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@pgtyped/cli": "^2.4.2",
    "@pgtyped/runtime": "^2.4.2",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "dotenv": "^16.4.7",
    "node-pg-migrate": "^7.9.0",
    "typescript": "^5.7.2"
  }
}
